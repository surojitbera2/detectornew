# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.github/
!/.github/**
!/backend/
!/backend/**
!/benchmarks/
!/benchmarks/**
!/deploy/
!/deploy/**
!/docs/
!/docs/**
!/frontend/
!/frontend/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/tests/
!/tests/**
!/.coderabbit.yaml
!/.dockerignore
!/.env.example
!/.env.production.example
!/.gitignore
!/.pre-commit-hooks.yaml
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/DEPLOY.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt

# Never commit runtime junk / secrets even under whitelisted folders
/frontend/node_modules/
/frontend/node_modules/**
/frontend/dist/
/frontend/dist/**
/frontend/public/bootstrap-dashboard.sh
/backend/__pycache__/
/backend/__pycache__/**
/backend/tests/__pycache__/
/backend/tests/__pycache__/**
/.env
/.env.local
/.env.production
!/ruff.toml
!/SECURITY.md

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
.env.*
*.env
credentials.json
*.pem
*.key
.credentials
