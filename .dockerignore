# The core wr-core image builds with `service/` as its context (uses
# service/.dockerignore for filtering). Dashboard images build with the repo
# root as context and need backend/ + frontend/ to be visible.

# Start by denying everything
*

# Then explicitly allow the dashboard build inputs
!backend/
!backend/**
!frontend/
!frontend/**

# Never send secrets, node_modules, or build junk into the image context
frontend/node_modules
frontend/node_modules/**
frontend/dist
frontend/dist/**
frontend/public/bootstrap-dashboard.sh
backend/__pycache__
backend/__pycache__/**
backend/tests/__pycache__
backend/tests/__pycache__/**
.env
.env.local
.env.production
