# =====================================================================
# watermarks-remover VPS deployment - production .env
# Copy to `.env` at the repo root, edit the values, then never commit it.
# =====================================================================

# ---------- Domain / URLs ----------
# Public URL where users will open the dashboard (must match your Nginx vhost)
DASHBOARD_ORIGIN=https://aiagent.sciencedomain.info

# Internal URL the dashboard backend uses to reach the core service.
# Do NOT change unless you rename the compose service.
WATERMARKS_SERVICE_URL=http://wr-core:8765

# ---------- Admin login ----------
# These are the credentials you use to sign in at DASHBOARD_ORIGIN.
# After the first boot they are saved (bcrypt-hashed) to ./data/admin.json
# and can be rotated from inside the dashboard (Change password button).
ADMIN_USERNAME=adminai
ADMIN_PASSWORD=Admin#Ai#2026*

# ---------- Secrets (MUST be replaced with real random values) ----------
# API key the backend uses to talk to wr-core. Generate with:
#   openssl rand -hex 32
WATERMARKS_SERVER_API_KEY=REPLACE_WITH_openssl_rand_hex_32

# Signs the browser session cookie. Generate with:
#   openssl rand -hex 48
SESSION_SECRET=REPLACE_WITH_openssl_rand_hex_48

# ---------- Cookie hardening ----------
# Keep 1 in production (HTTPS). Set to 0 only for local http testing.
COOKIE_SECURE=1

# ---------- Optional: enable extra text-watermark detectors ----------
# Keyed Gumbel (Aaronson EXP) replay: fires ONLY for text generated with
# this exact key. Any 32+ char random hex string is fine. Generate with:
#   openssl rand -hex 32
# (Stylometry runs automatically on any text of ≥ 30 words — no env needed.)
WATERMARKS_GUMBEL_KEY=REPLACE_WITH_openssl_rand_hex_32
